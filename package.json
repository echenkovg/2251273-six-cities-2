{
  "name": "six-cities",
  "version": "5.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "cli": "tsx src/main.cli.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "mock": "json-server ./mocks/mock-server-data.json --port 4000 --watch",
    "dev:api": "tsx watch src/main.rest.ts",
    "dev:cli": "tsx src/main.cli.ts",
    "build": "npm run clean && npm run compile",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "start:rest": "npm run docker:up && npm run build && node dist/main.rest.js",
    "start:cli": "node dist/main.cli.js",
    "dev:full": "npm run docker:up && concurrently -k -n \"API,MOCK\" -c \"cyan,yellow\" \"npm run dev:api\" \"npm run mock\"",
    "dev": "npm run docker:up && npm run dev:api"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/convict": "^6.1.6",
    "@types/convict-format-with-validator": "6.0.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "6.7.0",
    "@typescript-eslint/parser": "6.7.0",
    "concurrently": "10.0.4",
    "eslint": "8.49.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "1.0.0-beta.15",
    "pino-pretty": "13.1.3",
    "rimraf": "5.0.1",
    "ts-node": "10.9.1",
    "tsx": "4.23.0",
    "typescript": "5.2.2"
  },
  "type": "module",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "chalk": "5.6.2",
    "class-transformer": "0.5.1",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-async-handler": "1.2.0",
    "got": "15.1.0",
    "http-status-codes": "2.3.0",
    "inversify": "^8.2.1",
    "jsonwebtoken": "9.0.3",
    "mime-types": "^3.0.2",
    "mongoose": "9.8.0",
    "multer": "^2.3.0",
    "nanoid": "^3.3.18",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  }
}
